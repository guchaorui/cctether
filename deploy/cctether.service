# systemd user service: keeps cctether running on a server, even when you're logged out.
# `cctether setup` writes and starts this for you; this copy is for doing it by hand.
#
#   mkdir -p ~/.config/systemd/user
#   cp cctether.service ~/.config/systemd/user/
#   # edit ExecStart if `command -v cctether` is somewhere else. systemd's PATH is short: if node
#   # isn't in /usr/local/bin or /usr/bin, fix the Environment=PATH line (or call node by full path)
#   systemctl --user daemon-reload
#   systemctl --user enable --now cctether
#   sudo loginctl enable-linger "$USER"     # start at boot without logging in
#   journalctl --user -u cctether -f         # logs

[Unit]
Description=cctether: browser tools for Claude Code
After=network.target

[Service]
Type=exec
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/cctether daemon --takeover
Restart=always
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=%h/.config/cctether

[Install]
WantedBy=default.target
