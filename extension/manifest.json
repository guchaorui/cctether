{
  "manifest_version": 3,
  "name": "cctether",
  "short_name": "cctether",
  "description": "__MSG_extDescription__",
  "version": "0.1.0",
  "default_locale": "en",
  "minimum_chrome_version": "120",
  "key": "",
  "background": {
    "service_worker": "background/main.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "cctether",
    "default_icon": {
      "16": "icons/state/unpaired-16.png",
      "32": "icons/state/unpaired-32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["debugger", "tabs", "tabGroups", "storage", "alarms", "management"]
}
